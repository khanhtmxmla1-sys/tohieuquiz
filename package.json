{
  "name": "tohieuquiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap:generate": "node scripts/generate_sitemap.cjs",
    "build": "node scripts/cloudflare-build-router.mjs",
    "build:frontend": "npm run sitemap:generate && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "tsc -p workers/tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:stubbed": "cypress run --e2e --spec \"cypress/e2e/ai-quiz-generation-v2.cy.ts,cypress/e2e/gift-shop.cy.ts,cypress/e2e/manual-quiz-workspace.cy.ts,cypress/e2e/mobile-responsive.cy.ts,cypress/e2e/parent-portal.cy.ts,cypress/e2e/route-scroll.cy.ts,cypress/e2e/unified-notifications.cy.ts\"",
    "cypress:run:blueprint-v3": "cypress run --e2e --spec \"cypress/e2e/ai-question-blueprint-v3.cy.ts\"",
    "cypress:run:component": "cypress run --component",
    "cypress:math-screenshots": "node scripts/math-visual-regression.mjs",
    "cypress:math-screenshots:update": "node scripts/math-visual-regression.mjs --update",
    "certificates:render-backgrounds": "node scripts/render-certificate-backgrounds.mjs",
    "audit:dependencies": "node scripts/dependency-audit-report.mjs",
    "audit:dependencies:production": "node scripts/dependency-audit-report.mjs --production",
    "audit:dependencies:enforce": "node scripts/dependency-audit-report.mjs --production --enforce",
    "deploy": "npm run build && wrangler deploy",
    "security:scan": "node scripts/security-scan.mjs",
    "security:check": "npm run security:scan && npm run audit:dependencies:production",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/papaparse": "^5.5.2",
    "@vercel/analytics": "^1.6.1",
    "better-react-mathjax": "^2.3.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.5.1",
    "dom-to-image-more": "^3.10.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "image-nano": "^1.0.2",
    "jose": "^6.2.3",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router": "8.3.0",
    "read-excel-file": "9.3.4",
    "recharts": "^3.8.1",
    "write-excel-file": "4.1.1",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "cypress": "^15.8.1",
    "dotenv": "^17.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^27.3.0",
    "postcss": "8.5.23",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "uuid": ">=14.0.0",
    "brace-expansion@<1.1.16": "1.1.16",
    "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
