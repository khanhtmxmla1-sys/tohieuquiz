{
  "name": "tohieuquiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets:mathjax",
    "dev": "vite",
    "assets:mathjax": "node scripts/prepare-mathjax-assets.mjs",
    "assets:module-icons": "node scripts/build-module-icons.mjs",
    "assets:teacher-dashboard": "node scripts/build-teacher-dashboard-assets.mjs --write",
    "sitemap:generate": "node scripts/generate_sitemap.cjs",
    "build": "node scripts/cloudflare-build-router.mjs",
    "prebuild:frontend": "npm run assets:mathjax",
    "build:frontend": "vite build && node scripts/generate_sitemap.cjs dist/sitemap.xml",
    "preview": "npm run build && wrangler dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "tsc -p workers/tsconfig.json --noEmit",
    "typecheck:question-bank": "tsc -p tsconfig.question-bank.json --noEmit",
    "question-bank:math5:skeleton": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-bank/generate-math5-skeleton.ts",
    "question-bank:math5:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-bank/generate-math5-dataset.ts",
    "question-bank:math5:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-bank/validate-math5-dataset.ts",
    "question-bank:math5:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-bank/build-math5-review-report.ts",
    "question-bank:math5:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-bank/import-math5-drafts.ts",
    "question-bank:math5:publish": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-bank/publish-math5-topic.ts",
    "test:coverage": "vitest run tests/schemas.test.ts tests/questionSchemaCoverage.test.ts tests/InputValidator.test.ts tests/authAndLiveExamSchemas.test.ts tests/svgQuestionSchema.test.ts --coverage --maxWorkers=1",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:stubbed": "cypress run --e2e --spec \"cypress/e2e/ai-quiz-generation-v2.cy.ts,cypress/e2e/gift-shop.cy.ts,cypress/e2e/login-home.cy.ts,cypress/e2e/manual-quiz-workspace.cy.ts,cypress/e2e/mobile-responsive.cy.ts,cypress/e2e/parent-portal.cy.ts,cypress/e2e/question-scoring-matrix.cy.ts,cypress/e2e/route-scroll.cy.ts,cypress/e2e/unified-notifications.cy.ts\"",
    "cypress:run:blueprint-v3": "cypress run --e2e --spec \"cypress/e2e/ai-question-blueprint-v3.cy.ts\"",
    "cypress:run:svg-diagrams": "cypress run --e2e --spec \"cypress/e2e/ai-svg-diagrams.cy.ts\"",
    "cypress:run:production-smoke": "node scripts/run-production-smoke.mjs",
    "rollout:staged": "node scripts/run-staged-rollout.mjs",
    "cypress:run:component": "cypress run --component",
    "cypress:math-screenshots": "node scripts/math-visual-regression.mjs",
    "cypress:math-screenshots:update": "node scripts/math-visual-regression.mjs --update",
    "certificates:render-backgrounds": "node scripts/render-certificate-backgrounds.mjs",
    "audit:dependencies": "node scripts/dependency-audit-report.mjs",
    "audit:dependencies:production": "node scripts/dependency-audit-report.mjs --production",
    "audit:dependencies:workers:production": "node scripts/dependency-audit-report.mjs --production --workspace=workers",
    "audit:dependencies:enforce": "node scripts/dependency-audit-report.mjs --production --enforce",
    "audit:dependencies:workers:enforce": "node scripts/dependency-audit-report.mjs --production --workspace=workers --enforce",
    "audit:dependencies:all:enforce": "npm run audit:dependencies:enforce && npm run audit:dependencies:workers:enforce",
    "deploy": "npm run build && wrangler deploy",
    "security:scan": "node scripts/security-scan.mjs",
    "security:history": "node scripts/security-history-scan.mjs",
    "security:policies": "node scripts/security-policy-gates.mjs",
    "security:check": "npm run security:scan && npm run security:history && npm run security:policies && npm run audit:dependencies:all:enforce",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "test:ci:shard": "vitest run --maxWorkers=2",
    "test:ci:all": "node scripts/run-vitest-shards.mjs",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:strict && npm run typecheck:workers && npm run test:ci:all && npm run test:coverage && npm run build && npm run security:check",
    "release:readiness": "node scripts/release-readiness.mjs",
    "perf:analyze": "node scripts/analyze-bundle.mjs",
    "perf:budget": "node scripts/analyze-bundle.mjs --check",
    "perf:collections": "node scripts/benchmark-list-endpoints.mjs",
    "perf:live-exam": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/live-exam-load-test.ts",
    "perf:live-exam:100": "npm run perf:live-exam -- --concurrency 100",
    "perf:live-exam:150": "npm run perf:live-exam -- --concurrency 150",
    "d1:migrations:safe": "node workers/scripts/apply-d1-migrations-safe.cjs",
    "d1:cleanup:test-data": "node workers/scripts/cleanup-production-test-data.cjs",
    "d1:repair:smoke-fixtures": "node workers/scripts/repair-production-smoke-fixtures.cjs",
    "audit:scoring-contracts": "node workers/scripts/audit-scoring-contracts.cjs",
    "report:result-regrading": "node workers/scripts/report-result-regrading.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simplewebauthn/browser": "13.3.0",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/papaparse": "^5.5.2",
    "@vercel/analytics": "^1.6.1",
    "better-react-mathjax": "^2.3.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.5.1",
    "dom-to-image-more": "^3.10.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "image-nano": "^1.0.2",
    "jose": "^6.2.3",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router": "8.3.0",
    "read-excel-file": "9.3.4",
    "recharts": "^3.8.1",
    "web-vitals": "^6.0.1",
    "write-excel-file": "4.1.1",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.12.1",
    "cypress": "^15.8.1",
    "dotenv": "^17.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^27.3.0",
    "postcss": "8.5.23",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "uuid": ">=14.0.0",
    "brace-expansion@<1.1.16": "1.1.16",
    "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
