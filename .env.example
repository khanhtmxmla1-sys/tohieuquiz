# TôHiệuQuiz local configuration

# Public frontend configuration. Leave empty on Vercel to use the same-origin /api rewrite.
# Direct API deployments may set: VITE_WORKERS_API_URL=https://api.thtohieu.com
# Release identifier attached to sanitized frontend error reports.
VITE_APP_RELEASE=local
# Keep same-origin unless the approved telemetry receiver changes.
VITE_CLIENT_ERROR_REPORT_URL=/api/client-errors
VITE_WORKERS_API_URL=
# Local-only API proxy target used by Vite dev server.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_FEATURE_GIFT_SHOP_V2=false
VITE_FEATURE_AI_QUIZ_V2=false
VITE_FEATURE_AI_BLUEPRINT_V3=false
VITE_FEATURE_PARENT_PORTAL_V1=false
VITE_GIFT_SHOP_MODE=api

# Optional Cloudinary delivery-only configuration for avatar assets.
# User uploads use the authenticated Worker -> R2 media endpoint.
VITE_CLOUDINARY_AVATAR_BASE_URL=
VITE_CLOUDINARY_AVATAR_FOLDER=

# Build-only sitemap configuration.
SITEMAP_SITE_URL=https://www.thtohieu.com
SITEMAP_API_URL=
SITEMAP_API_TOKEN=

# Production AI/auth credentials are Cloudflare Worker secrets:
#   JWT_SECRET
#   CLIPROXY_TOKEN
# Provision them with `wrangler secret put`; never expose them through VITE_* variables.
