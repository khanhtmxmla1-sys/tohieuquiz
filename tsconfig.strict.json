{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "schemas/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "workers",
    "tests"
  ]
}
